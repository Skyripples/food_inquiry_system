{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "食品商品資料 V2.0",
  "description": "定義 products.json 的文件、商品與正式食品成分格式。",
  "type": "object",
  "required": ["schemaVersion", "products"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "quantity": {
      "description": "每份規格的數值與單位。",
      "type": "object",
      "required": ["amount", "unit"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nutrient": {
      "description": "營養素的數值與單位。",
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ingredientRatio": {
      "description": "來源有公開比例時才提供；不得由應用程式自行推算。",
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "ingredient": {
      "description": "單一食品成分；sourceId 引用同一商品 sources 陣列中的來源 id。",
      "type": "object",
      "required": ["name", "sourceId"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "ratio": { "$ref": "#/$defs/ingredientRatio" },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "ingredientList": {
      "description": "依食品標示的原始順序保存成分；JSON 陣列順序即為標示順序。",
      "type": "array",
      "items": { "$ref": "#/$defs/ingredient" }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "nutrition": {
      "type": "object",
      "properties": {
        "calories": { "$ref": "#/$defs/nutrient" },
        "protein": { "$ref": "#/$defs/nutrient" },
        "fat": { "$ref": "#/$defs/nutrient" },
        "saturatedFat": { "$ref": "#/$defs/nutrient" },
        "transFat": { "$ref": "#/$defs/nutrient" },
        "carbohydrates": { "$ref": "#/$defs/nutrient" },
        "sugar": { "$ref": "#/$defs/nutrient" },
        "sodium": { "$ref": "#/$defs/nutrient" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "name", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "verified_at": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "brand": { "type": "string" },
        "barcode": { "type": "string" },
        "serving": {
          "$ref": "#/$defs/quantity",
          "description": "每份規格。"
        },
        "nutrition": {
          "$ref": "#/$defs/nutrition",
          "description": "每份營養。"
        },
        "ingredients": { "$ref": "#/$defs/ingredientList" },
        "additives": { "$ref": "#/$defs/stringList" },
        "allergens": { "$ref": "#/$defs/stringList" },
        "nutritionSource": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "引用同一商品 sources 陣列中的來源 id；關聯由商品驗證層檢查。"
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      },
      "additionalProperties": false
    }
  }
}
